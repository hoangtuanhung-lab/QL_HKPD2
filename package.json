{
  "name": "hkpd-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "env:init": "node scripts/environment.mjs init",
    "env:check": "node scripts/environment.mjs check",
    "dev:api": "node scripts/environment.mjs api dev",
    "dev:worker": "node scripts/environment.mjs worker dev",
    "dev:web": "node scripts/environment.mjs web dev",
    "staging:api": "node scripts/environment.mjs api staging",
    "staging:worker": "node scripts/environment.mjs worker staging",
    "staging:web": "node scripts/environment.mjs web staging",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dev": "node scripts/services.mjs dev",
    "staging": "node scripts/services.mjs staging",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
