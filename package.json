{
  "name": "hkpd-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run business:check && npm run group-a:check && npm run contracts:check && npm run db:check && npm run lint && npm run typecheck && npm test && npm run build",
    "env:init": "node scripts/environment.mjs init",
    "env:check": "node scripts/environment.mjs check",
    "dev:api": "node scripts/environment.mjs api dev",
    "dev:worker": "node scripts/environment.mjs worker dev",
    "dev:web": "node scripts/environment.mjs web dev",
    "staging:api": "node scripts/environment.mjs api staging",
    "staging:worker": "node scripts/environment.mjs worker staging",
    "staging:web": "node scripts/environment.mjs web staging",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dev": "node scripts/services.mjs dev",
    "staging": "node scripts/services.mjs staging",
    "doctor": "node scripts/doctor.mjs",
    "contracts:generate": "openapi-typescript docs/api/core.openapi.json -o packages/contracts/src/generated.ts && prettier --write packages/contracts/src/generated.ts",
    "contracts:check": "node scripts/contracts-check.mjs",
    "dev:mock": "node scripts/mock-api.mjs",
    "github:audit": "node scripts/github-audit.mjs",
    "business:generate": "node scripts/business-baseline.mjs --generate",
    "business:check": "node scripts/business-baseline.mjs --check",
    "group-a:generate": "node scripts/group-a.mjs --generate",
    "group-a:check": "node scripts/group-a.mjs --check",
    "fixtures:a05": "node scripts/export-a05.mjs",
    "db:check": "bash infra/db/tests/run_all.sh",
    "prebuild": "npm run build --workspace @hkpd/foundation --workspace @hkpd/competition --workspace @hkpd/registration --workspace @hkpd/results",
    "pretest": "npm run build --workspace @hkpd/foundation --workspace @hkpd/competition --workspace @hkpd/registration --workspace @hkpd/results",
    "release:audit": "node scripts/release-readiness.mjs",
    "data:reconcile": "node scripts/reconcile-data.mjs"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
